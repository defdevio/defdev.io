---
// Giscus comments embed (https://giscus.app), powered by GitHub Discussions.
//
// TODO: Replace data-repo-id and data-category-id below with the values
// generated at https://giscus.app once GitHub Discussions is enabled on
// defdevio/defdev.io and the giscus GitHub App is installed. Also update
// data-category if a different discussion category name is chosen.
---

<div class="giscus"></div>

<script
  is:inline
  src="https://giscus.app/client.js"
  data-repo="defdevio/defdev.io"
  data-repo-id="REPLACE_WITH_REPO_ID"
  data-category="Comments"
  data-category-id="REPLACE_WITH_CATEGORY_ID"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="bottom"
  data-theme="https://www.defdev.io/giscus-theme.css"
  data-lang="en"
  data-loading="lazy"
  crossorigin="anonymous"
  async></script>
